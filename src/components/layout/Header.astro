---
import { nav, secondaryNav } from '@/config/site';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Mark from '@/components/ui/Mark.astro';

interface Props {
  tone?: 'light' | 'ink';
}
const { tone = 'light' } = Astro.props;
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class:list={['site-header', tone === 'ink' && 'surface-ink']}>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Kurongeka, home">
      <Mark size={26} />
      <span class="wordmark">kurongeka</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/find" class="header-icon" aria-current={isCurrent('/find') ? 'page' : undefined}>
        <Icon name="search" size="md" />
        <span class="visually-hidden">Search</span>
      </a>
      <a href="/account" class="header-login" aria-current={isCurrent('/account') ? 'page' : undefined}>Log in</a>
      <Button href="/check" variant={tone === 'ink' ? 'accent' : 'primary'} track="cta_header_check" class="header-cta">
        Free check
      </Button>

      <details class="nav-mobile" data-mobile-nav>
        <summary aria-label="Menu">
          <Icon name="menu" size="md" class="icon-open" />
          <Icon name="close" size="md" class="icon-close" />
        </summary>
        <div class="drawer surface-ink">
          <form class="drawer-search" action="/find" method="get" role="search">
            <label for="drawer-q" class="visually-hidden">Search</label>
            <Icon name="search" size="md" />
            <input id="drawer-q" name="q" type="search" placeholder="What do you need?" autocomplete="off" enterkeyhint="search" />
          </form>
          <nav aria-label="Main">
            <ul class="drawer-primary">
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <ul class="drawer-secondary">
              {
                secondaryNav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="drawer-actions">
            <Button href="/check" variant="accent" size="lg" block track="cta_menu_check">Take the free check</Button>
            <Button href="/account" variant="secondary" size="lg" block icon="user" iconPosition="start">Client log in</Button>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
  if (menu) {
    const close = () => {
      menu.open = false;
    };
    menu.addEventListener('toggle', () => {
      document.documentElement.classList.toggle('menu-open', menu.open);
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        close();
        menu.querySelector('summary')?.focus();
      }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 1.375rem;
    letter-spacing: -0.035em;
    line-height: 1.2;
    padding-bottom: 0.1em;
  }

  .nav-desktop {
    display: none;
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
  }

  .nav-desktop a,
  .header-login {
    position: relative;
    font-size: var(--text-small);
    text-decoration: none;
    color: var(--color-text-muted);
    padding-block: var(--space-2);
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav-desktop a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease-out);
  }

  .nav-desktop a:hover,
  .nav-desktop a[aria-current='page'],
  .header-login:hover,
  .header-login[aria-current='page'] {
    color: var(--color-text);
  }

  .nav-desktop a:hover::after,
  .nav-desktop a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
  }

  /* On small phones search lives at the top of the menu instead. */
  .header-icon {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text);
  }

  .header-icon:hover,
  .header-icon[aria-current='page'] {
    background: var(--color-bg-alt);
  }

  .header-login {
    display: none;
    padding-inline: var(--space-3);
  }

  .header-actions :global(.header-cta) {
    display: none;
  }

  .nav-mobile summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile :global(.icon-close),
  .nav-mobile[open] :global(.icon-open) {
    display: none;
  }

  .nav-mobile[open] :global(.icon-close) {
    display: block;
  }

  .nav-mobile:not([open]) .drawer {
    display: none;
  }

  .drawer {
    position: fixed;
    inset: var(--header-height) 0 0 0;
    z-index: var(--z-drawer);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-5) var(--gutter) calc(var(--space-6) + env(safe-area-inset-bottom));
    overflow-y: auto;
  }

  .drawer-search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .drawer-search input {
    flex: 1;
    min-width: 0;
    height: 3.25rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    outline: none;
  }

  .drawer-search:focus-within {
    outline: 2px solid var(--color-yellow);
    outline-offset: 3px;
  }

  .drawer ul {
    list-style: none;
    padding: 0;
  }

  .drawer-primary li + li {
    border-top: 1px solid var(--color-border);
  }

  .drawer-primary a {
    display: block;
    padding: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: var(--weight-bold);
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .drawer-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
  }

  .drawer-secondary a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .drawer a[aria-current='page'] {
    color: var(--color-yellow);
  }

  .drawer-actions {
    display: grid;
    gap: var(--space-3);
    margin-top: auto;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (min-width: 360px) {
    .header-actions :global(.header-cta) {
      display: inline-flex;
      flex-shrink: 0;
      white-space: nowrap;
      padding-inline: var(--space-4);
    }
  }

  @media (min-width: 480px) {
    .header-icon {
      display: grid;
    }
  }

  @media (min-width: 1024px) {
    .header-inner {
      gap: var(--space-7);
    }
    .header-actions {
      gap: var(--space-2);
    }
    .nav-desktop {
      display: block;
    }
    .nav-mobile {
      display: none;
    }
    .header-login {
      display: inline-block;
    }
  }
</style>
