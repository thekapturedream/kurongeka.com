---
import StatusMessage from '@/components/ui/StatusMessage.astro';
import { whatsappUrl } from '@/config/site';
import { formatMoney } from '@/lib/domain/format';
import type { RunPlan } from '@/lib/domain/types';

interface Props {
  plans: RunPlan[];
  failed?: boolean;
}
const { plans, failed = false } = Astro.props;
const displayName = (name: string) => name.replace(/^Run\s+/i, '');
---

{
  plans.length === 0 ? (
    <StatusMessage kind={failed ? 'error' : 'empty'} title={failed ? 'Monthly plans are not loading right now' : 'Monthly plans are being updated'}>
      <p>
        Ask us on <a href={whatsappUrl('Hi Kurongeka, what do your monthly Run plans cost?')}>WhatsApp</a> for current
        prices.
      </p>
    </StatusMessage>
  ) : (
    <ul class="plans" role="list">
      {plans.map((plan) => (
        <li class="plan">
          <div class="plan-head">
            <h3 class="h4">{displayName(plan.name)}</h3>
            <p class="plan-price">
              <span class="price-main">{formatMoney(plan.price, plan.currency)}</span>
              <span class="muted small">{plan.interval === 'one-off' ? 'one-off' : `a ${plan.interval}`}</span>
            </p>
          </div>
          {plan.perks.length > 0 && (
            <ul class="check-list small">
              {plan.perks.map((perk) => (
                <li>{perk}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .plans {
    display: grid;
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .plan {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .plan-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    white-space: nowrap;
  }

  .price-main {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
  }

  @media (min-width: 1024px) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-7);
      border-top: 0;
    }

    .plan {
      align-content: start;
      padding: var(--space-5) 0 0;
      border-top: 2px solid var(--color-text);
      border-bottom: 0;
    }

    .plan-head {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
