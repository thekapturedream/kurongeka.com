---
import Icon from '@/components/ui/Icon.astro';
import StatusMessage from '@/components/ui/StatusMessage.astro';
import { whatsappUrl } from '@/config/site';
import { solutionPrice } from '@/lib/domain/search-index';
import type { RunPlan, Solution } from '@/lib/domain/types';

interface Props {
  solutions: Solution[];
  runPlans: RunPlan[];
  failed?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { solutions, runPlans, failed = false, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

{
  solutions.length === 0 ? (
    <StatusMessage kind={failed ? 'error' : 'empty'} title={failed ? 'Solutions are not loading right now.' : 'Solutions are coming soon.'}>
      <p>
        Tell us what you need on <a href={whatsappUrl('Hello Kurongeka, I need help with my business online.')}>WhatsApp</a> or{' '}
        <a href="/contact?topic=call">book a free call</a>.
      </p>
    </StatusMessage>
  ) : (
    <ul class="cards" role="list">
      {solutions.map((s) => {
        const price = solutionPrice(s, runPlans);
        return (
          <li class="card">
            <span class="card-icon">
              <Icon name={s.icon} size="lg" />
            </span>
            <Heading class="h3">
              <a href={`/solutions/${s.slug}`}>{s.title}</a>
            </Heading>
            <p class="muted">{s.summary}</p>
            {price && <p class="card-price">{price}</p>}
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .cards {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .card:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  .card:focus-within {
    border-color: var(--color-text);
  }

  .card-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
  }

  .card-icon {
    flex-shrink: 0;
  }

  .card a {
    color: inherit;
    text-decoration: none;
  }

  /* The whole card is the link target. */
  .card a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-price {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-small);
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>
