---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

/**
 * primary: ink on light surfaces. accent: yellow, for ink surfaces only.
 * secondary: outlined. text: inline action with arrow.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'accent' | 'secondary' | 'text';
  size?: 'md' | 'lg';
  block?: boolean;
  type?: 'button' | 'submit';
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  external?: boolean;
  track?: string;
  class?: string;
  attrs?: HTMLAttributes<'a'> & HTMLAttributes<'button'>;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  block = false,
  type = 'button',
  icon,
  iconPosition = 'end',
  external = false,
  track,
  class: className,
  attrs = {},
} = Astro.props;

const classes = ['btn', `btn-${variant}`, `btn-${size}`, block && 'btn-block', className];
const trackAttr = track ? { 'data-track': track } : {};
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      {...(external ? { target: '_blank', rel: 'noopener' } : {})}
      {...trackAttr}
      {...attrs}
    >
      {icon && iconPosition === 'start' && <Icon name={icon} />}
      <span>
        <slot />
      </span>
      {icon && iconPosition === 'end' && <Icon name={icon} />}
      {external && <span class="visually-hidden"> (opens in a new tab)</span>}
    </a>
  ) : (
    <button type={type} class:list={classes} {...trackAttr} {...attrs}>
      {icon && iconPosition === 'start' && <Icon name={icon} />}
      <span>
        <slot />
      </span>
      {icon && iconPosition === 'end' && <Icon name={icon} />}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--control-height);
    padding: 0 var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    max-width: 100%;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn-lg {
    min-height: var(--control-height-lg);
    padding: 0 var(--space-6);
    font-size: 1.0625rem;
  }

  .btn-block {
    width: 100%;
  }

  .btn-primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .btn-primary:hover {
    background: #262b2d;
  }

  .btn-accent {
    background: var(--color-yellow);
    color: var(--color-ink);
  }

  .btn-accent:hover {
    background: var(--color-yellow-hover);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-line-strong);
  }

  :global(.surface-ink) .btn-secondary {
    border-color: var(--color-ink-line);
  }

  .btn-secondary:hover {
    border-color: currentColor;
  }

  .btn-text {
    min-height: auto;
    padding: var(--space-2) 0;
    white-space: normal;
    text-align: left;
    background: none;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
  }

  .btn-text:hover {
    text-decoration-color: currentColor;
  }

  .btn-text :global(.icon) {
    transition: transform var(--duration) var(--ease-out);
  }

  .btn-text:hover :global(.icon) {
    transform: translateX(3px);
  }

  @media (max-width: 399px) {
    .btn {
      white-space: normal;
      text-align: center;
      padding-block: var(--space-3);
    }
  }

  .btn[disabled],
  .btn[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }
</style>
