---
/**
 * The Kurongeka mark: eight points arranged around a centre, one in Kapture yellow.
 * Inherits currentColor so it works on light and ink surfaces.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="32" cy="32" r="14" fill="currentColor"></circle>
  <circle cx="32" cy="6" r="4" fill="currentColor"></circle>
  <circle cx="50.4" cy="13.6" r="4" fill="#FFCC00"></circle>
  <circle cx="58" cy="32" r="4" fill="currentColor"></circle>
  <circle cx="50.4" cy="50.4" r="4" fill="currentColor"></circle>
  <circle cx="32" cy="58" r="4" fill="currentColor"></circle>
  <circle cx="13.6" cy="50.4" r="4" fill="currentColor"></circle>
  <circle cx="6" cy="32" r="4" fill="currentColor"></circle>
  <circle cx="13.6" cy="13.6" r="4" fill="currentColor"></circle>
</svg>
