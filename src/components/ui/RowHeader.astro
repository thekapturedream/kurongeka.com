---
import Icon from './Icon.astro';

/** A section title with an optional "see all" link on the right, for browsable rows. */
interface Props {
  id: string;
  title: string;
  lead?: string | undefined;
  href?: string | undefined;
  linkLabel?: string | undefined;
}
const { id, title, lead, href, linkLabel } = Astro.props;
---

<header class="row-header">
  <div class="row-copy">
    <h2 id={id}>{title}</h2>
    {lead && <p class="muted">{lead}</p>}
  </div>
  {
    href && linkLabel && (
      <a class="row-link" href={href}>
        <span>{linkLabel}</span>
        <Icon name="arrow-right" />
      </a>
    )
  }
</header>

<style>
  .row-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-bottom: var(--space-7);
  }

  .row-copy {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
  }

  .row-copy h2 {
    font-size: var(--text-h2);
  }

  .row-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .row-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .row-link :global(.icon) {
    transition: transform var(--duration) var(--ease-out);
  }

  .row-link:hover :global(.icon) {
    transform: translateX(3px);
  }
</style>
