---
import Field from '@/components/forms/Field.astro';
import Button from '@/components/ui/Button.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { whatsappUrl } from '@/config/site';
import { signIn, type AuthError } from '@/lib/auth/login';
import { hasSession } from '@/lib/auth/session';
import { signInSchema } from '@/lib/domain/projects';
import { fieldErrors } from '@/lib/domain/validation';
import { clientKey, formValues, noStore, readForm, safeNextPath } from '@/lib/http';
import { allowAuthAttempt } from '@/lib/services/rate-limit';

export const prerender = false;
noStore(Astro);

const next = safeNextPath(Astro.url.searchParams.get('next'));
if (Astro.request.method === 'GET' && hasSession(Astro.cookies)) return Astro.redirect(next);

const MESSAGES: Record<AuthError | 'limited', string> = {
  'invalid-credentials': 'That email and password do not match. Check them, or reset your password.',
  'reset-required': 'For security, please set a new password before logging in.',
  captcha: 'We could not confirm the login. Please try again in a few minutes.',
  'email-exists': 'An account with this email already exists.',
  'invalid-email': 'Enter a valid email address.',
  'invalid-code': 'That code is not right.',
  expired: 'That took too long. Please log in again.',
  unavailable: 'Logging in is not working right now. Please try again shortly.',
  limited: 'Too many attempts. Please wait a few minutes and try again.',
};

let values = { email: '', password: '' };
let errors: Record<string, string> = {};
let message: string | null = null;
let pendingApproval = false;

const notice = Astro.url.searchParams.get('notice');
const info =
  notice === 'password-updated'
    ? 'Your password is updated. Log in with your new password.'
    : notice === 'signed-out'
      ? 'You are logged out.'
      : notice === 'session-ended'
        ? 'Please log in again to continue.'
        : null;

if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  values = form ? formValues(form, ['email', 'password'] as const) : values;
  const postedNext = safeNextPath(typeof form?.get('next') === 'string' ? String(form?.get('next')) : null);
  const parsed = signInSchema.safeParse(values);
  if (!allowAuthAttempt(clientKey(Astro.request, () => Astro.clientAddress))) {
    message = MESSAGES.limited;
  } else if (!parsed.success) {
    errors = fieldErrors(parsed.error);
  } else {
    const outcome = await signIn(parsed.data.email, parsed.data.password, { cookies: Astro.cookies, url: Astro.url });
    if (outcome.kind === 'signed-in') return Astro.redirect(postedNext, 303);
    if (outcome.kind === 'redirect') return Astro.redirect(outcome.url, 303);
    if (outcome.kind === 'verify') return Astro.redirect(`/account/verify?next=${encodeURIComponent(postedNext)}`, 303);
    if (outcome.kind === 'pending-approval') pendingApproval = true;
    if (outcome.kind === 'error') message = MESSAGES[outcome.error];
  }
  values.password = '';
  Astro.response.status = message || Object.keys(errors).length ? 400 : 200;
}
---

<AuthLayout title="Log in" heading="Log in to your account." lead="For Kurongeka clients. See your launch, previews and next steps.">
  {info && <p class="notice notice-success" role="status">{info}</p>}
  {message && <p class="notice notice-error" role="alert">{message}</p>}
  {
    pendingApproval && (
      <p class="notice notice-info" role="status">
        Your account is waiting for approval. We will email you when it is ready.
      </p>
    )
  }

  <form method="post" class="form-card" novalidate>
    <input type="hidden" name="next" value={next} />
    <div class="fields">
      <Field name="email" label="Email" type="email" autocomplete="email" required maxlength={254} value={values.email} error={errors['email']} />
      <Field
        name="password"
        label="Password"
        type="password"
        autocomplete="current-password"
        required
        maxlength={100}
        error={errors['password']}
      />
    </div>
    <div class="form-actions">
      <Button type="submit" size="lg" block track="account_login_submit">Log in</Button>
    </div>
    <p class="small links">
      <a href="/account/reset">Forgot your password?</a>
      <span aria-hidden="true">·</span>
      <a href={`/account/register${next !== '/account' ? `?next=${encodeURIComponent(next)}` : ''}`}>Create an account</a>
    </p>
  </form>

  <p class="small muted">
    Trouble logging in? <a href={whatsappUrl('Hi Kurongeka, I cannot log in to my account.')}>Message us on WhatsApp</a>.
  </p>
</AuthLayout>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
