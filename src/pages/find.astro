---
import Finder from '@/components/finder/Finder.astro';
import SolutionTiles from '@/components/solutions/SolutionTiles.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import LinkChips from '@/components/ui/LinkChips.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { whatsappUrl } from '@/config/site';
import { KIND_LABEL, search, type SearchKind, type SearchResult } from '@/lib/domain/search';
import { cachePage } from '@/lib/http';
import { getBusinessModels, getSolutions } from '@/lib/services/catalog';
import { getSearchIndex } from '@/lib/services/search';

export const prerender = false;

const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 80);
const [index, solutions, models] = await Promise.all([getSearchIndex(), getSolutions(), getBusinessModels()]);
cachePage(Astro, { ok: index.ok });

const results = query ? search(index.data, query, 24) : [];
const groups = (['solution', 'business-type', 'tool', 'page'] as SearchKind[])
  .map((kind) => ({ kind, items: results.filter((r) => r.kind === kind) }))
  .filter((g) => g.items.length > 0);

const GROUP_TITLE: Record<SearchKind, string> = {
  solution: 'Solutions',
  'business-type': 'Business types',
  tool: 'Free tools',
  page: 'Pages',
};

const metaLine = (r: SearchResult) => [KIND_LABEL[r.kind], r.meta].filter(Boolean).join(' · ');
---

<BaseLayout
  title={query ? `Search results for “${query}”` : 'Find what your business needs'}
  description="Search Kurongeka for websites, brands, bookings, payments and more, by what you need or by your type of business."
  noindex
>
  <section class="find-hero">
    <div class="container-narrow find-inner">
      <h1>{query ? 'Here is what we found.' : 'What does your business need?'}</h1>
      <Finder index={index.data} id="find" query={query} size="lg" autofocus={!query} />
    </div>
  </section>

  <section class="find-body">
    <div class="container-narrow">
      {
        query && groups.length > 0 && (
          <div class="groups" data-track-view="search_results" data-track-param-count={String(results.length)}>
            {groups.map((group) => (
              <section aria-labelledby={`group-${group.kind}`}>
                <h2 id={`group-${group.kind}`} class="group-title">
                  {GROUP_TITLE[group.kind]}
                </h2>
                <ul class="results" role="list">
                  {group.items.map((r) => (
                    <li>
                      <a class="result" href={r.href}>
                        <span class="result-text">
                          <span class="result-title">{r.title}</span>
                          <span class="result-summary">{r.summary}</span>
                        </span>
                        <span class="result-meta">{metaLine(r)}</span>
                        <Icon name="arrow-right" class="result-arrow" />
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        )
      }

      {
        query && groups.length === 0 && (
          <div class="empty" data-track-view="search_empty">
            <h2 class="h3">Nothing matched “{query}” yet.</h2>
            <p class="muted">
              Try a simpler word, such as website, logo, bookings or payments. Or tell us what you need and we will point you
              the right way.
            </p>
            <div class="empty-actions">
              <Button href="/check" icon="arrow-right">
                Take the free check
              </Button>
              <Button href={whatsappUrl(`Hello Kurongeka, I am looking for: ${query}`)} variant="secondary" icon="whatsapp" iconPosition="start" external>
                Ask on WhatsApp
              </Button>
            </div>
          </div>
        )
      }

      {
        (!query || groups.length === 0) && (
          <div class="browse">
            <section aria-labelledby="browse-solutions">
              <h2 id="browse-solutions" class="group-title">
                Solutions
              </h2>
              <SolutionTiles solutions={solutions.data} />
            </section>
            {models.data.length > 0 && (
              <section aria-labelledby="browse-types">
                <h2 id="browse-types" class="group-title">
                  Business types
                </h2>
                <LinkChips links={models.data.map((m) => ({ label: m.title, href: `/business-types/${m.slug}` }))} />
              </section>
            )}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .find-hero {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) var(--space-7);
  }

  .find-inner {
    display: grid;
    gap: var(--space-6);
  }

  .find-body {
    padding-bottom: var(--section-pad);
  }

  .groups,
  .browse {
    display: grid;
    gap: var(--space-8);
  }

  .group-title {
    font-size: var(--text-h4);
    margin-bottom: var(--space-4);
  }

  .results {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .result {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-text);
  }

  .result-text {
    display: grid;
    gap: var(--space-1);
  }

  .result-title {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .result-summary {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .result-meta {
    grid-column: 1;
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .result :global(.result-arrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    transition: transform var(--duration) var(--ease-out);
  }

  .result:hover .result-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .result:hover :global(.result-arrow) {
    transform: translateX(3px);
  }

  .empty {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

</style>
