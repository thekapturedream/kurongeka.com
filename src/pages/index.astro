---
import Finder from '@/components/finder/Finder.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import FaqList from '@/components/sections/FaqList.astro';
import PackageCards from '@/components/sections/PackageCards.astro';
import ToolCards from '@/components/sections/ToolCards.astro';
import SolutionTiles from '@/components/solutions/SolutionTiles.astro';
import Icon from '@/components/ui/Icon.astro';
import RowHeader from '@/components/ui/RowHeader.astro';
import StatusMessage from '@/components/ui/StatusMessage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, whatsappUrl } from '@/config/site';
import { formatMoney } from '@/lib/domain/format';
import { cachePage } from '@/lib/http';
import { faqLd, organizationLd, websiteLd } from '@/lib/seo';
import { getBusinessModels, getFaqs, getLaunchPackages, getRunPlans, getSolutions } from '@/lib/services/catalog';
import { getSearchIndex } from '@/lib/services/search';

const [packages, models, faqs, plans, solutions, index] = await Promise.all([
  getLaunchPackages(),
  getBusinessModels(),
  getFaqs(),
  getRunPlans(),
  getSolutions(),
  getSearchIndex(),
]);
cachePage(Astro, { ok: packages.ok && models.ok && faqs.ok && plans.ok && solutions.ok });

const cheapestPlan = [...plans.data].sort((a, b) => a.price - b.price)[0];
const homeFaqs = faqs.data.filter((f) => f.topic === 'general' || f.topic === 'pricing').slice(0, 5);
const days = packages.data.map((p) => p.deliveryDays).filter((d): d is number => d !== null);
const launchWindow = days.length > 0 ? `Live in ${Math.min(...days)} to ${Math.max(...days)} working days` : 'Live in days, not months';

const steps = [
  { title: 'Check', body: 'Seven quick questions. You get your score, and a manager calls within one working day.' },
  { title: 'Launch', body: 'Pick a fixed-price package. We build it, connect payments and bookings, and show you how it works.' },
  { title: 'Run', body: 'Manage it yourself from the Wix app, or let us look after updates and content every month.' },
];
---

<BaseLayout
  title="Kurongeka: your business, properly set up"
  exactTitle
  description={site.description}
  headerTone="ink"
  jsonLd={[organizationLd(), websiteLd(), faqLd(homeFaqs)]}
>
  <section class="hero surface-ink" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="hero-title" class="display">What does your business need<span class="accent-dot">?</span></h1>
        <p class="hero-lead">
          Websites, brands, bookings and payments for small businesses. Fixed prices in pounds, live in days, then kept
          running.
        </p>
      </div>
      <div class="hero-finder">
        <Finder index={index.data} id="hero" size="lg" onInk />
      </div>
      {
        solutions.data.length > 0 ? (
          <SolutionTiles solutions={solutions.data} label="Popular solutions" />
        ) : (
          <p class="hero-fallback">
            <a href="/pricing">See what every package includes</a>
          </p>
        )
      }
      <ul class="hero-facts" role="list">
        <li>Fixed prices, agreed upfront</li>
        <li>{launchWindow}</li>
        <li>You own your site and data</li>
        <li>Run from the {site.base}</li>
      </ul>
    </div>
  </section>

  <section class="row" aria-labelledby="types-title">
    <div class="container">
      <RowHeader
        id="types-title"
        title="Start from your type of business."
        lead="Each launch begins with a model built for how your kind of business wins customers."
        href="/business-types"
        linkLabel="All business types"
      />
      {
        models.data.length > 0 ? (
          <ul class="types" role="list">
            {models.data.map((m) => (
              <li>
                <a class="type" href={`/business-types/${m.slug}`}>
                  <span class="type-title">{m.title}</span>
                  <span class="type-summary">{m.summary}</span>
                  <Icon name="arrow-right" class="type-arrow" />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <StatusMessage kind={models.ok ? 'empty' : 'error'} title="Business types are not loading right now.">
            <p>
              Tell us what you do on <a href={whatsappUrl('Hello Kurongeka, I run a business and need help online.')}>WhatsApp</a>.
            </p>
          </StatusMessage>
        )
      }
    </div>
  </section>

  <section class="row surface-alt" aria-labelledby="pricing-title">
    <div class="container">
      <RowHeader
        id="pricing-title"
        title="Fixed prices. Agreed before we start."
        lead={cheapestPlan
          ? `Launch once, then keep it running from ${formatMoney(cheapestPlan.price, cheapestPlan.currency)} a month, or run it yourself.`
          : 'Launch once, then run it yourself or with us every month.'}
        href="/pricing"
        linkLabel="Compare packages"
      />
      <PackageCards packages={packages.data} failed={!packages.ok} includeLimit={4} />
    </div>
  </section>

  <section class="row" aria-labelledby="how-title">
    <div class="container">
      <RowHeader id="how-title" title="Three steps. No long briefs." href="/how-it-works" linkLabel="How it works" />
      <ol class="steps" role="list">
        {
          steps.map((step, i) => (
            <li class="step">
              <span class="step-number" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{step.title}</h3>
              <p class="muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="row row-tight" aria-labelledby="tools-title">
    <div class="container">
      <RowHeader
        id="tools-title"
        title="Free tools. No sign-up."
        lead="Check your website, find a domain, set your brand colours and make an email signature."
        href="/tools"
        linkLabel="All tools"
      />
      <ToolCards />
    </div>
  </section>

  {
    homeFaqs.length > 0 && (
      <section class="row" aria-labelledby="faq-title">
        <div class="container faq-grid">
          <div class="faq-intro">
            <h2 id="faq-title">Straight answers.</h2>
            <p class="muted">
              Something else? <a href="/contact?topic=question">Ask us</a> and we reply within one working day.
            </p>
          </div>
          <FaqList faqs={homeFaqs} />
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .hero-inner {
    display: grid;
    gap: var(--space-6);
  }

  .hero-inner > * {
    min-width: 0;
  }

  .hero-copy {
    display: grid;
    gap: var(--space-4);
  }

  .hero-copy h1 {
    max-width: 16ch;
  }

  .hero-lead {
    max-width: 38rem;
    font-size: var(--text-lead);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .hero-finder {
    max-width: 46rem;
  }

  .hero-fallback a {
    color: var(--color-text);
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero-facts li::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-yellow);
  }

  .row {
    padding-block: var(--section-pad);
  }

  .row-tight {
    padding-bottom: calc(var(--section-pad) / 2);
  }

  /* Business types: an editorial index, not a wall of cards. */
  .types {
    display: grid;
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .types li {
    border-bottom: 1px solid var(--color-border);
  }

  .type {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) var(--space-4);
    align-items: center;
    height: 100%;
    padding: var(--space-5) 0;
    text-decoration: none;
    color: var(--color-text);
  }

  .type-title {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 1.125rem;
    letter-spacing: -0.015em;
    line-height: var(--leading-snug);
  }

  .type-summary {
    grid-column: 1;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .type :global(.type-arrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    transition: transform var(--duration) var(--ease-out);
  }

  .type:hover .type-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .type:hover :global(.type-arrow) {
    transform: translateX(4px);
  }

  .steps {
    display: grid;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
  }

  .step {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .step-number {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-line-strong);
  }

  .faq-grid {
    display: grid;
    gap: var(--space-7);
  }

  .faq-intro {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .faq-intro a {
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .types {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-7);
    }
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-7);
    }
  }

  @media (min-width: 1024px) {
    .types {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .faq-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-9);
    }
  }
</style>
