---
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import SolutionTiles from '@/components/solutions/SolutionTiles.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import StatusMessage from '@/components/ui/StatusMessage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tools } from '@/config/tools';
import { formatPrice, workingDays } from '@/lib/domain/format';
import { solutionPrice } from '@/lib/domain/search-index';
import { cachePage } from '@/lib/http';
import { breadcrumbLd, solutionLd } from '@/lib/seo';
import { getLaunchPackages, getRunPlans, getSolutions } from '@/lib/services/catalog';

const slug = Astro.params.slug ?? '';
const [solutions, packages, plans] = await Promise.all([getSolutions(), getLaunchPackages(), getRunPlans()]);

const solution = solutions.data.find((s) => s.slug === slug) ?? null;
const notFound = solutions.ok && !solution;
if (!solutions.ok) {
  Astro.response.status = 503;
  cachePage(Astro, { ok: false });
} else if (notFound) {
  Astro.response.status = 404;
  cachePage(Astro, { maxAge: 60 });
} else {
  cachePage(Astro, { ok: packages.ok && plans.ok });
}

const path = `/solutions/${slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Solutions', path: '/solutions' },
  { name: solution?.title ?? 'Solution', path },
];

const from = solution?.fromPackage ?? null;
const price = solution ? solutionPrice(solution, plans.data) : null;
const includedIn = from ? packages.data.filter((p) => p.price !== null && from.price !== null && p.price >= from.price) : [];
const tool = solution?.relatedTool ? tools.find((t) => t.slug === solution.relatedTool) ?? null : null;
const isRun = solution?.offer === 'run';
const priceNote = isRun
  ? 'Monthly, cancel any time'
  : from?.deliveryDays
    ? `One-off, live in about ${workingDays(from.deliveryDays)}`
    : 'One-off';
---

{
  solution ? (
    <BaseLayout
      title={solution.seoTitle || solution.title}
      description={solution.seoDescription || solution.summary}
      jsonLd={[breadcrumbLd(crumbs), solutionLd(solution, path, plans.data)]}
    >
      <section class="sol-hero">
        <div class="container">
          <Breadcrumbs items={crumbs} />
          <div class="sol-grid">
            <div class="sol-copy">
              <span class="sol-icon">
                <Icon name={solution.icon} size="lg" />
              </span>
              <h1>{solution.title}</h1>
              {solution.intro && <p class="lead">{solution.intro}</p>}
              {price && (
                <p class="sol-price">
                  <span class="sol-price-main">{price}</span>
                  <span class="muted">{priceNote}</span>
                </p>
              )}
              <div class="sol-actions">
                {isRun ? (
                  <Button href="/pricing#run-plans" size="lg" icon="arrow-right" track={`cta_solution_${solution.slug}`}>
                    See monthly plans
                  </Button>
                ) : (
                  <Button
                    href={from ? `/check?package=${from.slug}` : '/check'}
                    size="lg"
                    icon="arrow-right"
                    track={`cta_solution_${solution.slug}`}
                  >
                    Start with a free check
                  </Button>
                )}
                <Button href="/contact?topic=call" variant="secondary" size="lg" icon="calendar" iconPosition="start">
                  Book a free call
                </Button>
              </div>
            </div>

            <aside class="sol-panel" aria-labelledby="includes-title">
              <h2 id="includes-title" class="h4">What you get</h2>
              {solution.includes.length > 0 && (
                <ul class="check-list">
                  {solution.includes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {includedIn.length > 0 && (
                <p class="sol-packages">
                  Included in{' '}
                  {includedIn.map((p, i) => (
                    <>
                      {i > 0 && (i === includedIn.length - 1 ? ' and ' : ', ')}
                      <strong>{p.title}</strong>
                      {p.price !== null && <span class="muted"> {formatPrice(p.price)}</span>}
                    </>
                  ))}
                  . <a href="/pricing">Compare packages</a>
                </p>
              )}
            </aside>
          </div>
        </div>
      </section>

      {tool && (
        <section class="sol-tool">
          <div class="container">
            <a class="tool-banner" href={`/tools/${tool.slug}`} data-track={`tool_from_solution_${solution.slug}`}>
              <span class="tool-copy">
                <span class="label">Free tool</span>
                <span class="tool-name">{tool.name}</span>
                <span class="muted">{tool.summary}</span>
              </span>
              <span class="tool-open">
                Open the tool
                <Icon name="arrow-right" />
              </span>
            </a>
          </div>
        </section>
      )}

      <section class="sol-more" aria-labelledby="more-title">
        <div class="container">
          <h2 id="more-title" class="h3">Other solutions</h2>
          <SolutionTiles solutions={solutions.data} exclude={solution.slug} label="Other solutions" />
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title={notFound ? 'Solution not found' : 'Solution unavailable'} description="This solution could not be shown." noindex>
      <section class="sol-hero">
        <div class="container">
          <StatusMessage
            kind={notFound ? 'empty' : 'error'}
            title={notFound ? 'We could not find that solution' : 'This page is not loading right now'}
          >
            <p>
              {notFound ? 'It may have been renamed.' : 'Please try again in a moment.'} <a href="/solutions">See all solutions</a>{' '}
              or <a href="/find">search</a>.
            </p>
          </StatusMessage>
        </div>
      </section>
    </BaseLayout>
  )
}

<style>
  .sol-hero {
    padding-block: clamp(2rem, 1.25rem + 3vw, 4rem) var(--space-8);
  }

  .sol-grid {
    display: grid;
    gap: var(--space-7);
  }

  .sol-copy {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .sol-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-md);
    background: var(--color-ink);
    color: var(--color-yellow);
  }

  .sol-copy h1 {
    max-width: 16ch;
  }

  .sol-price {
    display: grid;
    gap: var(--space-1);
  }

  .sol-price-main {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
  }

  .sol-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .sol-panel {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    padding: clamp(var(--space-5), 1rem + 2vw, var(--space-7));
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
  }

  .sol-packages {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-small);
  }

  .sol-packages a {
    color: var(--color-text);
    white-space: nowrap;
  }

  .sol-tool {
    padding-bottom: var(--space-8);
  }

  .tool-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color var(--duration) var(--ease-out);
  }

  .tool-banner:hover {
    border-color: var(--color-text);
  }

  .tool-copy {
    display: grid;
    gap: var(--space-1);
    max-width: 40rem;
  }

  .tool-name {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h4);
  }

  .tool-open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
  }

  .tool-banner :global(.icon) {
    transition: transform var(--duration) var(--ease-out);
  }

  .tool-banner:hover :global(.icon) {
    transform: translateX(3px);
  }

  .sol-more {
    padding-block: var(--space-8) var(--section-pad);
    border-top: 1px solid var(--color-border);
  }

  .sol-more h2 {
    margin-bottom: var(--space-5);
  }

  @media (max-width: 479px) {
    .sol-actions > :global(*) {
      width: 100%;
    }
  }

  @media (min-width: 1024px) {
    .sol-grid {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-9);
      align-items: start;
    }
  }
</style>
